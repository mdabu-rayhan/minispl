# ==============================================================================
# BookHaven — Git Ignore Configuration
# ==============================================================================

# --- Maven & Compiled Java Artifacts ---
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# --- SQLite Runtime Database Files & Journals ---
# Generated dynamically at runtime by DatabaseManager & SQLite JDBC
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Log Files & JVM Crash Reports ---
*.log
logs/
hs_err_pid*
replay_pid*

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Eclipse IDE ---
.classpath
.project
.settings/
.factorypath
.springBeans

# --- Visual Studio Code ---
.vscode/
*.code-workspace

# --- NetBeans IDE ---
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# --- Operating System Artifacts ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux / Editor Swap Files
*~
*.swp
*.swo
*.tmp

# --- Agent & AI Scratch Directories ---
.agents/
.gemini/

# --- Markdown Documentation ---
# Ignore all markdown files across the repository
*.md
**/*.md

# Keep documentation files
!README.md
!readme.md
!DESIGN_PATTERNS.md
!design_patterns.md
!TECHNICAL_DOCUMENTATION.md
!technical_documentation.md
!CHANGELOG.md
!changelog.md
!docs/
!docs/**


